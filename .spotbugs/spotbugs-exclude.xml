<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <Match>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
  </Match>
  <Match>
    <!-- This allows us to use singleton pattern -->
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="MS_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
  </Match>
  <Match>
    <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <!-- Java11 build throws false positives: https://github.com/spotbugs/spotbugs/issues/811 -->
    <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Package name="io.strimzi.certs"/>
  </Match>
  <Match>
    <Class name="~io\.strimzi\.api\.kafka\.model\..+(Builder|Fluent)(\$.*)?" />
  </Match>
  <Match>
    <Class name="~io\.fabric8\.kubernetes\.api\.model\..+(Builder|Fluent)(\$.*)?" />
  </Match>
  <Match>
    <!-- Throws false positives in Fabric8 Kubernetes client (related to https://github.com/spotbugs/spotbugs/issues/1219) -->
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>
  <!-- This is excluded because the classes are generated by sundrio -->
  <Match>
    <Class name="~io\.strimzi\.systemtest\.(kafkaclients|resources\.operator)\..+(Builder|Fluent)(\$.*)?" />
  </Match>
  <Match>
    <!-- Allow methods to intentionally throw RuntimeException -->
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>
  <Match>
    <!-- Operator constructors intentionally throw when given invalid configuration
         or when model building fails. This is expected behaviour. -->
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <Match>
    <!-- These system test helpers read values from the JUnit ExtensionContext store, which is
         guaranteed to be populated for a running test, so the dereferenced value is never null. -->
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    <Or>
        <Class name="io.strimzi.systemtest.storage.TestStorage"/>
        <Class name="io.strimzi.systemtest.utils.StUtils"/>
        <Class name="io.strimzi.systemtest.utils.kubeUtils.objects.NetworkPolicyUtils"/>
    </Or>
  </Match>
</FindBugsFilter>
